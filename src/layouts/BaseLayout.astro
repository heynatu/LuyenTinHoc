---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import ToastRegion from '../components/ui/ToastRegion.astro';
import tokens from '../design/tokens.generated.json';
import { SITE } from '../site.config';
import { cleanPath } from '../lib/ui-logic';

interface Props {
  /** Tiêu đề riêng của trang; trang chủ để trống. */
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  ogImage = '/og-default.png',
} = Astro.props;

const fullTitle = title
  ? `${title} | ${SITE.name}`
  : `${SITE.name}: học tin học từng bước, luyện thi học sinh giỏi`;
const canonical = new URL(cleanPath(Astro.url.pathname), SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const themeLight = tokens.core.grayscale['00'];
const themeDark = tokens.core.grayscale['870'];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeDark} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline src="/theme-init.js"></script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main-content"
      class="button-sm sr-only rounded-8 bg-action-primary px-100 py-75 text-text-on-action focus:not-sr-only focus:fixed focus:top-200 focus:left-200 focus:z-60"
    >
      Bỏ qua tới nội dung chính
    </a>
    <SiteNav />
    <main id="main-content" tabindex="-1" class="flex-1 pt-900 outline-none" data-inert-when-menu>
      <slot />
    </main>
    <SiteFooter />
    <ToastRegion />
    <script>
      import '../lib/code-copy';
    </script>
  </body>
</html>
