---
/** Biểu tượng thương hiệu: ba nút nối nhau như một đồ thị nhỏ. Màu lấy từ token. */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<span
  class="inline-flex shrink-0 items-center justify-center rounded-8 bg-action-primary text-text-on-action"
  style={`width: ${size}px; height: ${size}px`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 32 32"
    width="70%"
    height="70%"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
  >
    <path d="M9 22 L16 10 L23 22 Z" stroke-linejoin="round"></path>
    <circle cx="16" cy="10" r="3.5" fill="currentColor" stroke="none"></circle>
    <circle cx="9" cy="22" r="3.5" fill="currentColor" stroke="none"></circle>
    <circle cx="23" cy="22" r="3.5" fill="currentColor" stroke="none"></circle>
  </svg>
</span>
