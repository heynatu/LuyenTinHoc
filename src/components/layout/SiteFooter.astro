---
import { FOOTER_LINKS, isPlaceholder, PRACTICE_LINKS, SITE } from '../../site.config';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
const emailReady = !isPlaceholder(SITE.contactEmail);
---

<footer class="mt-900" data-inert-when-menu>
  <div class="mx-auto w-full max-w-content px-200 md:px-400">
    <div class="h-px w-full bg-border-primary" role="presentation"></div>
  </div>
  <div class="mx-auto flex w-full max-w-content flex-col gap-500 px-200 py-700 md:flex-row md:justify-between md:px-400">
    <div class="flex max-w-narrow flex-col gap-200">
      <a href="/" class="flex items-center gap-75 text-text-primary">
        <BrandMark />
        <span class="title-2">{SITE.name}</span>
      </a>
      <p class="body-6 text-text-tertiary">{SITE.description}</p>
    </div>

    <div class="flex flex-col gap-500 sm:flex-row sm:gap-700">
      <nav aria-label="Khu thực hành" class="flex flex-col gap-100">
        <h2 class="caption-3 text-text-tertiary">Thực hành</h2>
        <ul class="flex flex-col gap-50">
          {PRACTICE_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="body-6 inline-flex min-h-touch items-center text-text-secondary transition duration-300 ease-base hover:text-text-primary sm:min-h-0"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Liên kết chân trang" class="flex flex-col gap-100">
        <h2 class="caption-3 text-text-tertiary">Trang</h2>
        <ul class="flex flex-col gap-50">
          {FOOTER_LINKS.map((link) =>
            link.ready ? (
              <li>
                <a
                  href={link.href}
                  class="body-6 inline-flex min-h-touch items-center text-text-secondary transition duration-300 ease-base hover:text-text-primary sm:min-h-0"
                >
                  {link.label}
                </a>
              </li>
            ) : (
              <li>
                <span
                  aria-disabled="true"
                  class="body-6 inline-flex min-h-touch items-center gap-75 text-text-tertiary sm:min-h-0"
                >
                  {link.label}
                  <span class="caption-5">(sắp có)</span>
                </span>
              </li>
            ),
          )}
        </ul>
      </nav>

      <div class="flex flex-col gap-100">
        <h2 class="caption-3 text-text-tertiary">Liên hệ</h2>
        {emailReady ? (
          <a
            href={`mailto:${SITE.contactEmail}`}
            class="body-6 text-text-secondary transition duration-300 ease-base hover:text-text-primary"
          >
            {SITE.contactEmail}
          </a>
        ) : (
          <span class="body-6 text-text-secondary">{SITE.contactEmail}</span>
        )}
        <span class="body-6 text-text-tertiary">Biên soạn: {SITE.organization}</span>
      </div>
    </div>
  </div>
  <div class="mx-auto w-full max-w-content px-200 pb-600 md:px-400">
    <p class="caption-5 text-text-tertiary">
      © {year} {SITE.organization}. Mã nguồn theo giấy phép {SITE.codeLicense}. Nội dung theo giấy
      phép {SITE.contentLicense}. Không dùng cookie, không thu thập dữ liệu cá nhân.
    </p>
  </div>
</footer>
