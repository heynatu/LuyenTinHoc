---
/** Ô nhập nhiều dòng (ví dụ ô Dữ liệu vào). Cùng trạng thái với Input. */
import type { HTMLAttributes } from 'astro/types';
import { describedBy, resolveFieldState } from './field';
import FieldShell from './FieldShell.astro';
import { cx, fieldClasses, type FieldState } from './recipes';

interface Props extends Omit<HTMLAttributes<'textarea'>, 'id'> {
  id: string;
  label: string;
  hint?: string;
  error?: string;
  state?: FieldState;
  mono?: boolean;
}

const {
  id,
  label,
  hint,
  error,
  state,
  mono = false,
  required,
  disabled,
  rows = 4,
  class: className,
  ...rest
} = Astro.props;
const look = resolveFieldState(state, Boolean(disabled));
const isDisabled = Boolean(disabled) || state === 'disabled';
---

<FieldShell
  id={id}
  label={label}
  hint={hint}
  error={error}
  required={Boolean(required)}
  disabled={isDisabled}
>
  <textarea
    id={id}
    rows={rows}
    class={cx(fieldClasses(look), 'resize-y', mono && 'font-mono', className)}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy(id, hint, error)}
    required={required}
    disabled={isDisabled}
    spellcheck={mono ? 'false' : undefined}
    {...rest}
  ><slot /></textarea>
</FieldShell>
