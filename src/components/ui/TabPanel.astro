---
/** Nội dung của một tab. `tabs` là id của Tabs chứa nó, `id` trùng id trong danh sách tabs. */
interface Props {
  tabs: string;
  id: string;
  active?: boolean;
}
const { tabs, id, active = false } = Astro.props;
---

<div
  role="tabpanel"
  id={`${tabs}-panel-${id}`}
  aria-labelledby={`${tabs}-tab-${id}`}
  tabindex="0"
  hidden={!active}
  class="rounded-12"
>
  <slot />
</div>
