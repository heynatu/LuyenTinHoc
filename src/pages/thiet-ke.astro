<script>
  import { showToast, type ToastTone } from '../lib/toast';

  const MESSAGES: Record<ToastTone, string> = {
    success: 'Đã lưu code nháp cho bài Tổng đoạn con lớn nhất.',
    info: 'Đang tải Python lần đầu, có thể mất vài giây.',
    warning: 'Còn 5 phút. Hãy lưu bài và kiểm tra tên file.',
    error: 'Chương trình chạy quá 3 giây nên đã được dừng. Kiểm tra điều kiện dừng của vòng lặp.',
  };

  document.querySelectorAll<HTMLButtonElement>('[data-demo-toast]').forEach((button) => {
    button.addEventListener('click', () => {
      const tone = button.dataset.demoToast as ToastTone;
      showToast({ tone, message: MESSAGES[tone] });
    });
  });

  document.querySelector('[data-demo-submit]')?.addEventListener('click', () => {
    showToast({ tone: 'success', message: 'Đã nộp bài. Kết quả chấm hiện sau vài giây.' });
  });

  document.getElementById('demo-retry')?.addEventListener('click', () => {
    showToast({ tone: 'info', message: 'Đang tải lại bộ test.' });
  });
</script>
