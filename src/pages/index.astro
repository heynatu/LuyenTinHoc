---
/**
 * Trang chủ (mục 4.2, theo landing-page-design). Một hành động chính: chọn cấp học.
 * Phong cách tham khảo các web học lập trình: màu tươi, nút nổi, linh vật, dải chủ đề, lộ trình.
 * Mọi con số lấy từ nội dung lúc build, không gõ tay.
 */
import {
  ArrowRightIcon,
  CheckCircleIcon,
  CheckIcon,
  DatabaseIcon,
  ExamIcon,
  FlowArrowIcon,
  NotebookIcon,
  PlayIcon,
  PuzzlePieceIcon,
  SealCheckIcon,
  TerminalWindowIcon,
  TreeStructureIcon,
  WarningIcon,
} from '@phosphor-icons/react/ssr';
import Mascot from '../components/brand/Mascot.astro';
import Roadmap from '../components/brand/Roadmap.astro';
import StreakCard from '../components/brand/StreakCard.astro';
import TopicMarquee from '../components/brand/TopicMarquee.astro';
import Accordion from '../components/ui/Accordion.astro';
import Button from '../components/ui/Button.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import Visualizer from '../components/viz/Visualizer.astro';
import { LEVEL_INFO } from '../data/taxonomy';
import { PUZZLES } from '../data/puzzles';
import { TRAPS } from '../data/traps';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLessons, getProblems } from '../lib/content';
import { verifyOf } from '../lib/problems';
import { ALGORITHMS } from '../lib/viz/registry';
import { SITE } from '../site.config';

const lessons = await getLessons();
const problems = await getProblems();
const verified = problems.map((p) => verifyOf(p.id)!);
const totalTests = verified.reduce((s, v) => s + v.tests, 0);
const totalStress = verified.reduce((s, v) => s + v.stressRounds, 0);
const count = (level: string) => lessons.filter((l) => l.data.level === level).length;

// Ô code ở hero: trích đúng các dòng chính của lời giải đã kiểm chứng (bỏ phần đọc ghi file).
const heroProblem = problems.find((p) => p.id === 'tong-chu-so');
const heroVerify = heroProblem ? verifyOf(heroProblem.id) : null;
const heroCode = `s = data[0].decode()  # giữ n ở dạng xâu
tong = 0
for c in s:
    tong += ord(c) - 48  # '0' có mã 48
out = str(tong)`;

const paths = [
  {
    level: 'tieu-hoc',
    title: 'Tiểu học',
    outcome: 'Chia việc thành các bước, dùng lặp và rẽ nhánh qua câu đố robot, thẻ nhị phân.',
    contest: 'Chuẩn bị cho Tin học trẻ bảng Tiểu học',
    icon: PuzzlePieceIcon,
    panel: 'bg-surface-success-subtle text-text-success-inverted',
    edge: 'hover:border-border-success',
  },
  {
    level: 'thcs',
    title: 'THCS',
    outcome:
      'Thuật toán, sơ đồ khối, tìm kiếm, sắp xếp; chuyển từ khối lệnh sang Python để thi học sinh giỏi lớp 9.',
    contest: 'Học sinh giỏi THCS, Tin học trẻ bảng THCS',
    icon: FlowArrowIcon,
    panel: 'bg-surface-info-subtle text-text-info-inverted',
    edge: 'hover:border-border-action-primary',
  },
  {
    level: 'thpt',
    title: 'THPT',
    outcome:
      'Python, cơ sở dữ liệu và SQL, kỹ thuật mảng, quy hoạch động, đồ thị cho kỳ thi cấp tỉnh.',
    contest: 'Học sinh giỏi tỉnh Gia Lai, Tin học trẻ bảng THPT',
    icon: DatabaseIcon,
    panel: 'bg-surface-accent-subtle text-text-on-warning',
    edge: 'hover:border-border-warning',
  },
] as const;

const stages = [
  {
    title: 'Tư duy máy tính',
    text: `${PUZZLES.length} câu đố robot, thẻ nhị phân, sắp xếp các bước.`,
    href: '/tu-duy',
    cta: 'Giải câu đố',
    tone: 'success',
  },
  {
    title: 'Bài học theo cấp',
    text: `${lessons.length} bài bám chương trình GDPT 2018, có câu hỏi kiểm tra.`,
    href: '/hoc',
    cta: 'Mở lộ trình',
    tone: 'primary',
  },
  {
    title: 'Xem thuật toán chạy',
    text: `${ALGORITHMS.length} mô phỏng từng bước với dữ liệu của bạn.`,
    href: '/mo-phong',
    cta: 'Xem mô phỏng',
    tone: 'accent',
  },
  {
    title: 'Luyện đề có chấm',
    text: `${problems.length} bài dạng đề học sinh giỏi, chấm thử ngay trên trình duyệt.`,
    href: '/luyen-de',
    cta: 'Làm bài luyện',
    tone: 'error',
  },
  {
    title: 'Thi thử bấm giờ',
    text: 'Đề tổng hợp có giới hạn thời gian như phòng thi thật.',
    href: '/thi-thu',
    cta: 'Vào thi thử',
    tone: 'inverted',
  },
] as const;

const trapPicks = ['sai-ten-file', 'doc-du-lieu-cham', 'truong-hop-bien', 'round-ngan-hang']
  .map((slug) => TRAPS.find((t) => t.slug === slug)!)
  .filter(Boolean);

const doing = [
  {
    icon: TreeStructureIcon,
    title: 'Mô phỏng từng bước',
    text: 'Nhập dữ liệu của bạn, bấm chạy, xem dòng giả mã và giá trị biến đổi theo từng bước.',
    href: '/mo-phong',
  },
  {
    icon: TerminalWindowIcon,
    title: 'Phòng lập trình Python và SQL',
    text: 'Chạy code ngay trên trình duyệt, đọc ghi file như phòng thi, lỗi giải thích bằng tiếng Việt.',
    href: '/lap-trinh',
  },
  {
    icon: ExamIcon,
    title: 'Chấm thử như Themis',
    text: 'Chạy từng test, so kết quả, tính điểm; tải bộ test để tự chấm trên máy.',
    href: '/luyen-de',
  },
];

const faq = [
  {
    q: 'LuyenTinHoc có miễn phí không?',
    a: 'Có. Mọi bài học, mô phỏng, đề luyện và bộ chấm thử đều dùng miễn phí.',
  },
  {
    q: 'Có cần đăng ký tài khoản không?',
    a: 'Không. Bạn mở trang là học được ngay, trang không có tài khoản và không dùng cookie.',
  },
  {
    q: 'Tiến độ học được lưu ở đâu?',
    a: 'Trong bộ nhớ của trình duyệt trên máy bạn, không gửi đi đâu. Ở trang Tiến độ, bạn có thể xuất ra file để sao lưu hoặc chuyển sang máy khác.',
  },
  {
    q: 'Dùng điện thoại được không?',
    a: 'Được. Bài học, mô phỏng và câu đố dùng tốt trên điện thoại. Viết code dài thì nên dùng máy tính. Lần đầu chạy Python, trình duyệt tải khoảng 13 MB.',
  },
  {
    q: 'Đề trên trang có phải đề thi thật không?',
    a: 'Mỗi bài ghi rõ một trong ba nhãn: Đề chính thức, Phỏng theo đề gốc, Đề luyện biên soạn. Hiện kho đề gồm đề luyện biên soạn theo dạng bài thường gặp; trang không gắn tên kỳ thi và năm cho đề tự soạn.',
  },
  {
    q: 'Lời giải dùng Python phiên bản nào?',
    a: 'Lời giải chỉ dùng thư viện chuẩn và được kiểm tra để chạy từ Python 3.8, vì máy chấm ở nhiều phòng thi dùng bản cũ. Phòng lập trình trên trình duyệt chạy Python bản mới.',
  },
  {
    q: 'Chấm thử có giống Themis không?',
    a: 'Giống ở cách chấm: chạy từng test, so kết quả, tính điểm theo tỉ lệ test đúng. Thời gian đo trên trình duyệt chỉ là ước lượng. Mỗi bài có nút tải bộ test theo cấu trúc thư mục của Themis để tự chấm trên máy.',
  },
  {
    q: 'Giáo viên dùng trong lớp thế nào?',
    a: 'Gửi đường dẫn bài học, bài luyện hoặc đề thi thử cho học sinh, in đề, tải bộ test. Xem hướng dẫn ở trang Dành cho giáo viên.',
  },
  {
    q: 'Sách THCS dùng lập trình khối lệnh, sao trang lại dạy Python?',
    a: 'Khái niệm biến, rẽ nhánh, vòng lặp giống nhau ở khối lệnh và Python; trang có bài chuyển từ khối lệnh sang Python. Ngôn ngữ được dùng ở mỗi kỳ thi cần xem thể lệ năm hiện hành.',
  },
  {
    q: 'Thấy lời giải sai thì báo ở đâu?',
    a: `Gửi thư tới ${SITE.contactEmail} kèm đường dẫn trang và mô tả ngắn. Thông tin liên hệ có ở trang Giới thiệu.`,
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}).replace(/</g, '\\u003c');

const resumeData = JSON.stringify({
  lessons: lessons.map((l) => ({ id: l.id, level: l.data.level, title: l.data.title })),
  problems: problems.map((p) => ({ id: p.id, title: p.data.title })),
});

const tagline = [
  ['Mỗi', 'dòng', 'code', 'đều', 'có', 'lý', 'do'],
  ['Hiểu', 'lý', 'do', 'để', 'đạt', 'giải', 'cao'],
];

const rotating = ['thuật toán', 'Python', 'SQL', 'đệ quy', 'đồ thị'];
const sectionTitle = 'heading-5 sm:heading-4 md:heading-2 text-text-primary';
---

<BaseLayout>
  <!-- 1. Hero -->
  <section class="mx-auto grid w-full max-w-content grid-cols-1 items-center gap-700 px-200 pt-600 pb-700 md:px-400 lg:grid-cols-2 lg:pt-800 lg:pb-800">
    <div class="flex max-w-hero flex-col gap-300">
      <h1 class="heading-3 sm:heading-2 xl:heading-1">
        <span class="sr-only">Hiểu thuật toán, tự tin vào phòng thi</span>
        <span class="text-hero-gradient" aria-hidden="true">
          Hiểu{' '}
          <span class="rotate-word" data-rotate={JSON.stringify(rotating)}>
            {rotating[0]}
          </span>
          <br />
          Tự tin vào phòng thi
        </span>
      </h1>
      <p class="body-3 md:title-2 text-text-secondary">
        Bài học bám chương trình GDPT 2018, mô phỏng thuật toán chạy ngay trên trình duyệt và kho đề
        luyện thi học sinh giỏi có lời giải Python đã kiểm chứng.
      </p>
      <div class="flex flex-wrap items-center gap-200">
        <Button href="#chon-cap" size="lg">
          Chọn cấp học của bạn
          <ArrowRightIcon size={20} aria-hidden="true" />
        </Button>
        <Button href="/lap-trinh" size="lg" variant="secondary">
          <PlayIcon size={20} aria-hidden="true" />
          Thử chạy Python
        </Button>
      </div>
      <ul class="flex flex-wrap gap-100" aria-label="Có gì trên LuyenTinHoc">
        {[
          `${lessons.length} bài học`,
          `${problems.length} bài luyện đã kiểm chứng`,
          `${ALGORITHMS.length} mô phỏng`,
          'Miễn phí, không tài khoản',
        ].map((label) => (
          <li class="caption-1 inline-flex items-center gap-50 rounded-full border border-border-primary bg-surface-primary-subtle px-100 py-50 text-text-secondary">
            <span class="inline-flex text-icon-success">
              <CheckIcon size={14} weight="bold" aria-hidden="true" />
            </span>
            {label}
          </li>
        ))}
      </ul>
    </div>

    <div class="relative min-w-0 pt-700 lg:pt-0">
      <Mascot size={112} wave class="absolute -top-100 right-200 z-10 lg:-top-800 lg:right-400" />
      <div class="raised edge-neutral relative flex flex-col gap-100 rounded-24 border border-border-primary bg-surface-primary p-100">
        <div class="flex items-center gap-75 px-100 pt-75" aria-hidden="true">
          <span class="size-100 rounded-full bg-surface-error" />
          <span class="size-100 rounded-full bg-surface-warning" />
          <span class="size-100 rounded-full bg-surface-success" />
          <span class="caption-4 ml-100 text-text-tertiary">Phòng lập trình</span>
        </div>
        <CodeBlock code={heroCode} title="TONGCS.PY" />
        <div class="grid grid-cols-2 gap-100">
          <div class="flex flex-col gap-25 rounded-16 bg-surface-secondary p-200">
            <span class="caption-4 text-text-tertiary">Dữ liệu vào</span>
            <span class="body-2 font-mono text-text-primary">2026</span>
          </div>
          <div class="flex flex-col gap-25 rounded-16 bg-surface-secondary p-200">
            <span class="caption-4 text-text-tertiary">Kết quả</span>
            <span class="body-2 font-mono text-text-primary">10</span>
          </div>
        </div>
        {heroVerify && heroProblem && (
          <a
            href={`/luyen-de/${heroProblem.id}`}
            class="flex min-h-touch items-center gap-100 rounded-16 bg-surface-success-subtle px-200 py-100 text-text-success-inverted transition duration-300 ease-base hover:opacity-90"
          >
            <CheckCircleIcon size={24} weight="fill" aria-hidden="true" />
            <span class="body-4 flex-1">
              Lời giải bài {heroProblem.data.title} đạt {heroVerify.tests}/{heroVerify.tests} test
            </span>
            <ArrowRightIcon size={18} aria-hidden="true" />
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Tiếp tục học: chỉ hiện khi trình duyệt đã có tiến độ -->
  <section
    aria-labelledby="tiep-tuc-title"
    class="mx-auto w-full max-w-content px-200 pb-600 md:px-400"
    data-continue={resumeData}
    hidden
  >
    <div class="raised edge-primary flex flex-col gap-200 rounded-24 border border-border-action-primary bg-surface-primary p-300 md:flex-row md:items-center">
      <Mascot size={64} />
      <div class="flex min-w-0 flex-1 flex-col gap-50">
        <h2 id="tiep-tuc-title" class="title-1 text-text-primary">
          Chào mừng bạn quay lại
        </h2>
        <p class="body-6 text-text-secondary" data-continue-summary></p>
      </div>
      <div class="flex flex-wrap gap-100">
        <Button href="/hoc" data-continue-lesson>
          Học tiếp
        </Button>
        <Button href="/luyen-de" variant="secondary" data-continue-problem hidden>
          Làm tiếp bài
        </Button>
      </div>
    </div>
  </section>

  <!-- 2. Dải chủ đề -->
  <section aria-label="Thuật toán có mô phỏng" class="pb-800">
    <TopicMarquee />
  </section>

  <!-- 3. Chọn lộ trình -->
  <section
    id="chon-cap"
    aria-labelledby="chon-cap-title"
    class="mx-auto flex w-full max-w-content scroll-mt-900 flex-col gap-500 px-200 pb-900 md:px-400"
    data-rise
  >
    <div class="flex max-w-hero flex-col gap-100">
      <h2 id="chon-cap-title" class={sectionTitle}>
        Bạn đang học cấp nào?
      </h2>
      <p class="body-3 md:title-2 text-text-secondary">
        Mỗi cấp có lộ trình riêng theo chương trình GDPT 2018 và kỳ thi tương ứng.
      </p>
    </div>
    <ul class="grid grid-cols-1 gap-300 md:grid-cols-3">
      {paths.map(({ level, title, outcome, contest, icon: Icon, panel, edge }) => (
        <li class="flex">
          <a
            href={`/hoc/${level}`}
            data-pick-level={level}
            class:list={[
              'raised edge-neutral group flex w-full flex-col gap-200 rounded-24 border border-border-primary bg-surface-primary p-100 transition duration-300 ease-base',
              edge,
            ]}
          >
            <span class:list={['flex items-center justify-between rounded-16 p-300', panel]}>
              <Icon size={48} weight="duotone" aria-hidden="true" />
              <span class="caption-3 rounded-full border border-current px-100 py-25">
                Lớp {LEVEL_INFO[level].grades[0]} đến {LEVEL_INFO[level].grades.at(-1)}
              </span>
            </span>
            <span class="flex flex-1 flex-col gap-100 px-200 pb-200">
              <span class="heading-5 text-text-primary">{title}</span>
              <span class="body-6 text-text-secondary">{outcome}</span>
              <span class="caption-2 mt-auto pt-100 text-text-tertiary">
                {count(level)} bài học. {contest}.
              </span>
              <span class="button-sm inline-flex items-center gap-50 pt-100 text-text-info">
                Bắt đầu lộ trình {LEVEL_INFO[level].label}
                <span class="inline-flex transition-transform duration-300 ease-base group-hover:translate-x-50">
                  <ArrowRightIcon size={16} aria-hidden="true" />
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 4. Lộ trình năm chặng -->
  <section aria-labelledby="lo-trinh" class="bg-surface-band" data-rise>
    <div class="mx-auto flex w-full max-w-content flex-col gap-600 px-200 py-900 md:px-400">
      <div class="flex max-w-hero flex-col gap-100">
        <h2 id="lo-trinh" class={sectionTitle}>
          Từ câu đố đầu tiên
          <br />
          tới phòng thi học sinh giỏi
        </h2>
        <p class="body-3 md:title-2 text-text-secondary">
          Năm chặng xếp theo thứ tự một giáo viên sẽ dạy. Bắt đầu ở chặng hợp với bạn.
        </p>
      </div>
      <Roadmap stages={stages} />
    </div>
  </section>

  <!-- 5. Học bằng cách làm -->
  <section
    aria-labelledby="hoc-bang-lam"
    class="mx-auto grid w-full max-w-content grid-cols-1 items-center gap-600 px-200 py-900 md:px-400 lg:grid-cols-5"
    data-rise
  >
    <div class="flex flex-col gap-300 lg:col-span-2">
      <h2 id="hoc-bang-lam" class="heading-5 sm:heading-4 md:heading-3 text-text-primary">
        Học bằng cách làm
      </h2>
      <p class="body-3 md:title-2 text-text-secondary">
        Không chỉ đọc lý thuyết: bạn chạy, sửa, xem kết quả ngay trên trình duyệt.
      </p>
      <ul class="flex flex-col gap-100">
        {doing.map(({ icon: Icon, title, text, href }) => (
          <li>
            <a
              href={href}
              class="flex gap-200 rounded-16 p-200 transition duration-300 ease-base hover:bg-surface-primary-hover"
            >
              <span class="inline-flex size-600 shrink-0 items-center justify-center rounded-12 bg-surface-info-subtle text-icon-info-inverted">
                <Icon size={24} aria-hidden="true" />
              </span>
              <span class="flex flex-col gap-25">
                <span class="title-3 text-text-primary">{title}</span>
                <span class="body-6 text-text-secondary">{text}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div
      class="raised edge-neutral min-w-0 rounded-24 border border-border-primary bg-surface-primary-subtle p-100 lg:col-span-3"
      aria-label="Mô phỏng sắp xếp nổi bọt chạy thử"
    >
      <div class="flex items-center gap-75 px-100 py-75" aria-hidden="true">
        <span class="size-100 rounded-full bg-surface-error" />
        <span class="size-100 rounded-full bg-surface-warning" />
        <span class="size-100 rounded-full bg-surface-success" />
        <span class="caption-4 ml-100 text-text-tertiary">Mô phỏng: sắp xếp nổi bọt</span>
      </div>
      <div class="rounded-16 bg-surface-primary p-200 md:p-300">
        <Visualizer slug="sap-xep-noi-bot" compact />
      </div>
    </div>
  </section>

  <!-- 6. Vấn đề và giải pháp -->
  <section aria-labelledby="mat-diem" class="bg-surface-band" data-rise>
    <div class="mx-auto grid w-full max-w-content grid-cols-1 gap-500 px-200 py-900 md:px-400 lg:grid-cols-5">
      <div class="flex flex-col gap-200 lg:col-span-2">
        <h2 id="mat-diem" class="heading-5 sm:heading-4 md:heading-3 text-text-primary">
          Vì sao bài đúng ý tưởng
          <br />
          vẫn mất điểm
        </h2>
        <p class="body-3 text-text-secondary">
          Nhiều bài mất điểm không phải vì thuật toán sai mà vì một chi tiết nhỏ khi đọc ghi file,
          đọc đề hay chọn hàm của Python. Thư viện bẫy gom {TRAPS.length} lỗi như vậy, mỗi lỗi có
          code sai, code đúng chạy thử được.
        </p>
        <div>
          <Button href="/bay-thuong-gap" variant="secondary">
            Xem {TRAPS.length} bẫy thường gặp
          </Button>
        </div>
      </div>
      <ul class="grid grid-cols-1 gap-200 sm:grid-cols-2 lg:col-span-3">
        {trapPicks.map((t) => (
