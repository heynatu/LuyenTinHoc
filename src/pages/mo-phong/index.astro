---
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Tag from '../../components/ui/Tag.astro';
import { LEVEL_INFO } from '../../data/taxonomy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ALGORITHMS, CATEGORY_LABELS } from '../../lib/viz/registry';
import type { Category } from '../../lib/viz/types';

const categories = Object.keys(CATEGORY_LABELS) as Category[];
---

<BaseLayout
  title="Mô phỏng thuật toán"
  description={`${ALGORITHMS.length} thuật toán chạy từng bước với dữ liệu của bạn: tìm kiếm, sắp xếp, số học, quy hoạch động, đồ thị, quay lui. Có giả mã tiếng Việt và code Python.`}
>
  <div class="mx-auto flex w-full max-w-content flex-col gap-700 px-200 pt-600 md:px-400">
    <PageHeader
      title="Mô phỏng thuật toán"
      crumbs={[]}
      lead={`${ALGORITHMS.length} thuật toán chạy từng bước với dữ liệu do bạn nhập. Mỗi bước tô sáng dòng giả mã đang chạy, giá trị các biến và giải thích bằng lời.`}
    />
    {categories.map((category) => {
      const items = ALGORITHMS.filter((a) => a.category === category);
      return (
        <section aria-labelledby={`nhom-${category}`} class="flex flex-col gap-300">
          <div class="flex max-w-hero flex-col gap-75">
            <h2 id={`nhom-${category}`} class="heading-5 text-text-primary">
              {CATEGORY_LABELS[category].title}
            </h2>
            <p class="body-6 text-text-secondary">{CATEGORY_LABELS[category].summary}</p>
          </div>
          <ul class="grid grid-cols-1 gap-200 md:grid-cols-2 xl:grid-cols-3">
            {items.map((algo) => (
              <li class="flex" data-level={algo.levels.join(' ')}>
                <Card href={`/mo-phong/${algo.slug}`} class="w-full">
                  <p class="title-2 text-text-primary">{algo.title}</p>
                  <p class="body-6 text-text-secondary">{algo.summary}</p>
                  <div class="mt-auto flex flex-wrap gap-50">
                    {algo.levels.map((level) => (
                      <Tag>{LEVEL_INFO[level].label}</Tag>
                    ))}
                    <Tag>{algo.complexity.average}</Tag>
                  </div>
                </Card>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</BaseLayout>
