{
  "name": "tu-duy-tin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nền tảng học Tin học cho học sinh Tiểu học, THCS, THPT theo Chương trình GDPT 2018",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <25"
  },
  "scripts": {
    "predev": "node scripts/ensure-native.mjs && node scripts/build-tokens.mjs && node scripts/copy-wasm.mjs",
    "dev": "astro dev",
    "prebuild": "node -e \"require('fs').existsSync('scripts/check-repo.cjs')||(console.error('Repo thiếu thư mục scripts/. Hãy đẩy đủ mọi file lên GitHub bằng git, xem README.md.'),process.exit(1))\" && node scripts/check-repo.cjs && node scripts/ensure-native.mjs && node scripts/build-tokens.mjs && node scripts/copy-wasm.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretypecheck": "node scripts/ensure-native.mjs && node scripts/copy-wasm.mjs",
    "typecheck": "astro check",
    "tokens": "node scripts/build-tokens.mjs",
    "lint:design": "node scripts/lint-design.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "pretest": "node scripts/ensure-native.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:content": "node scripts/run-python.mjs scripts/content/verify_content.py",
    "check:all": "npm run lint && npm run typecheck && npm run lint:design && npm run check:contrast && npm run test && npm run build && npm run check:links",
    "preview:vercel": "node scripts/serve-dist.mjs 4321",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.6",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "codemirror": "6.0.2",
    "minisearch": "7.2.0",
    "prismjs": "1.30.0",
    "pyodide": "314.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.16.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
